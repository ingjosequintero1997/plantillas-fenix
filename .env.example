# ============================================================
#  Plantilla de credenciales del backend (FENIX Data).
#  En el servidor: copia este archivo a  deploy/.env  y completa
#  los valores reales.  NUNCA subas deploy/.env al repositorio.
# ============================================================

# Usuario de Docker Hub: la imagen se llama josequintero1997/plantillas-fenix
# (no necesita variable aqui, ya esta fija en docker-compose.yml)

# ------------------------------------------------------------
# Base de datos principal (PostgreSQL) - datos de la aplicacion
# ------------------------------------------------------------
DATABASE_URL=postgresql://usuario:password@host:5436/base_sie_dusakawi

# ------------------------------------------------------------
# Base de datos corporativa (Dusakawi) - verificacion de afiliados
# ------------------------------------------------------------
CORP_DB_HOST=
CORP_DB_PORT=5435
CORP_DB_NAME=base_sie_dusakawi
CORP_DB_USER=
CORP_DB_PASSWORD=

# ------------------------------------------------------------
# Seguridad / autenticacion
# ------------------------------------------------------------
# Secreto para firmar los tokens. Obligatorio. Genera uno largo
# y aleatorio, por ejemplo:  openssl rand -hex 32
TOKEN_SECRET=
TOKEN_HOURS=8
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esta-clave

# ------------------------------------------------------------
# Opcionales
# ------------------------------------------------------------
# Root path del backend. Dejar vacio cuando se expone directo
# (Vercel hace el proxy de /api/* hacia este servidor).
API_ROOT_PATH=
