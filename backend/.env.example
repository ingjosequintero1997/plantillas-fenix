# ============================================================
#  Configuracion LOCAL del backend (SQLite persistente)
# ============================================================
# Este archivo se copia como .env en backend/ para desarrollo local.
# Con esta config, los datos se guardan en backend/validador.db
# y PERSISTEN entre reinicios del servidor local.

# Base de datos (SQLite local persistente)
DATABASE_URL=sqlite:///./validador.db

# Credenciales del admin de respaldo (se usan si la BD no tiene el usuario)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia_esta_clave

# Secreto para firmar los tokens (genera uno aleatorio largo, ej: openssl rand -hex 32)
TOKEN_SECRET=cambia_este_secreto_por_uno_aleatorio

# ============================================================
#  BD Corporativa (Dusakawi)
# ============================================================
CORP_DB_HOST=tu_host
CORP_DB_PORT=5432
CORP_DB_NAME=tu_base
CORP_DB_USER=tu_usuario
CORP_DB_PASSWORD=tu_password
