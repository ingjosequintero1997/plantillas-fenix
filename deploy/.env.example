# Plantilla de variables de entorno para PRODUCCION.
#
# COPIAR este archivo a `deploy/.env` EN EL SERVIDOR y completar los valores.
# El `.env` real NO se commitea (esta en .gitignore) y NO debe contener
# credenciales dentro del repositorio.

# Imagen Docker del backend (ej: tuusuario/fenix-backend:latest)
BACKEND_IMAGE=

# Base de datos del aplicativo (PRODUCCION)
# Formato: postgresql://USUARIO:PASSWORD@HOST:PUERTO/NOMBRE_BASE
DATABASE_URL=postgresql://USUARIO:PASSWORD@HOST:PUERTO/NOMBRE_BASE

# Base de datos corporativa (OPCIONAL).
# Si se dejan vacias, el backend usa la misma BD del aplicativo para el
# esquema `administrativo` (af_afiliado, ct_ips, tb_eps, tb_municipio).
CORP_DB_HOST=
CORP_DB_PORT=5432
CORP_DB_NAME=
CORP_DB_USER=
CORP_DB_PASSWORD=

# Firma de tokens de autenticacion
TOKEN_SECRET=

# Puerto interno del backend (el Dockerfile expone 9500)
PORT=9500
